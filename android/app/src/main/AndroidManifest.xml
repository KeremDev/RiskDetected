<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Meta App Events is intentionally measurement-only: never let an SDK dependency merge
         Google Advertising ID access into RiskDetected. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_TOPICS"
        tools:node="remove" />

    <!-- required=false: System Photo Picker (master §15.3) is a valid capture path without a
         camera, so this must stay installable on camera-less devices (e.g. Chrome OS). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- App Events test/attribution can resolve the installed Facebook app on Android 11+.
         This is package visibility only: it adds no Facebook Login activity or permission. -->
    <queries>
        <package android:name="com.facebook.katana" />
    </queries>

    <application
        android:name=".RiskDetectedApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.RiskDetected"
        android:supportsRtl="true">

        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="${firebaseMessagingAutoInitEnabled}" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${firebaseCrashlyticsCollectionEnabled}" />
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="${facebookSdkAutoInitEnabled}" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AutoAppLinkEnabled"
            android:value="false" />
        <!-- FCM renders background/killed-state notifications itself. These defaults keep that
             system-rendered path visually identical to our foreground notification path. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_monochrome" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/rd_notification_accent" />
        <!-- Without this the system-rendered path used FCM's fallback channel while the
             foreground path used ours, so the user saw two switches for one app's notifications.
             RdNotificationChannel creates this channel at startup, before any message arrives. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="riskdetected_updates" />

        <!--
          Ç1 (review doc): no certificate pinning in v1 — Network Security Config +
          HTTPS-only + system CA store is the accepted v1 baseline. android:allowBackup is
          false so no auto-backup can exfiltrate the encrypted session store (master §25.4).
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RiskDetected">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${applicationId}"
                    android:host="login-callback" />
            </intent-filter>
        </activity>

        <!-- Generated PDF/XLSX report files are written to cache and handed to a viewer/share
             target via a content:// Uri — file:// Uris are blocked across app boundaries on
             modern Android (FileUriExposedException), so a FileProvider is required. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM push registration. Payload parsing is restricted to typed route + record IDs. -->
        <service
            android:name=".push.RdFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
