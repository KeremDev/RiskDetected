<?xml version="1.0" encoding="utf-8"?>
<!--
  Ç1 (review doc §7): v1 security baseline is HTTPS-only + system CA trust, no cert pinning.
  cleartextTrafficPermitted defaults to false here — no domain override adds it back, so this
  applies to every environment including debug/qa.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
