  "defects_found_and_fixed": [
    {
      "check": "an_account_that_never_paid_or_can_not_be_read_is_no_candidate",
      "cause": "the probe picked its invitee with ORDER BY id LIMIT 1 over public.profiles, which the P14 slice had since changed",
      "fix": "the probe creates its own accounts and queries the unreadable owner from the projection"
    },
    {
      "check": "personnel_advisor unindexed_foreign_keys",
      "cause": "four foreign keys were only covered by composites whose leading column was something else",
      "fix": "four real indexes added to the migration; none of them was silenced in the advisor list"
    },
    {
      "check": "an_unpublished_campaign_qualifies_nobody",
      "cause": "a random claim id made the call fail on the missing row, not on the publication gate",
      "fix": "a second draft revision of the same campaign is evaluated with the real claim"
    },
    {
      "check": "the_same_operation_is_never_counted_twice",
      "cause": "the helper generated a fresh operation id on every call",
      "fix": "the operation id is reused and a replay is expected"
    },
    {
      "check": "a_paused_campaign_rewards_nobody_new",
      "cause": "the new claim was never qualified, so the pause gate was never reached",
      "fix": "claim, qualify, then pause, then award"
    },
    {
      "check": "open_winback_episode suppression record",
      "cause": "the function recorded the refusal and then raised, so the subtransaction rolled the record back",
      "fix": "return opened:false with the reason code instead of raising"
    },
    {
      "check": "record_winback_contact consent handling",
      "cause": "a missing consent closed the episode for good",
      "fix": "design corrected: consent_missing records a suppression but leaves the episode open; every other refusal closes it and none resets the clock"
    }
  ],
