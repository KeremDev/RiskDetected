        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: Automatic retention policy also works. Free photos are stored for 7 days, Plus photos are stored for 30 days, Pro photos are stored unlimitedly; reports remain until the user deletes them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
