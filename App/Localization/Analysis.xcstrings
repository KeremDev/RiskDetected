    "analysis.analysis.canvas.fotograftaki.ekipmani.tanimla.ve.isg.acisindan.d.017d1919": {
      "comment": "swift_user_copy; App/Models/AnalysisCanvas.swift:73; placeholders: none; review: machine_draft",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identify the equipment in the photo and evaluate it from an OHS perspective. If you're not sure, state the possibilities, don't make assumptions. Give short headings: equipment name, hazards, risks, precautions, PPE required, pre-use checks and stop criteria. If there is a critical risk, warn first. If there is missing information, request additional photos or make/model."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraftaki ekipmanı tanımla ve İSG açısından değerlendir. Emin değilsen olasılıkları belirt, varsayım yapma. Kısa başlıklarla şunları ver: ekipman adı, tehlikeler, riskler, önlemler, gerekli KKD, kullanım öncesi kontroller ve durdurma kriterleri. Kritik risk varsa en başta uyar. Eksik bilgi varsa ek fotoğraf veya marka/model iste."
          }
        }
      }
    },
