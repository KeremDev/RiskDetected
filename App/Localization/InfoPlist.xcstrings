      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RiskDetected needs photo-library access so you can select site photos for analysis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saha fotoğraflarını analiz edebilmek için galerine erişim izni gerekiyor."
