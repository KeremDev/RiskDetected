    "NSCameraUsageDescription": {
      "comment": "Camera permission purpose string; placeholders: none; review: machine_draft",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RiskDetected needs camera access to capture site photos for workplace-safety analysis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RiskDetected, saha fotoğrafları çekerek iş güvenliği analizi yapabilmek için kamerana ihtiyaç duyar."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
